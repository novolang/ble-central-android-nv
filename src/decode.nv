// decode: what the runtime of an Android app reports, as the events and the values of ble-central-nv.
//
// The runtime hands the program one event at a time as a kind, a link, a status, one integer, a text and bytes (`Raw`).  `event_of` turns it into a
// `CentralEvent`, and keeps the one fact of each link the trait needs and the platform does not give as an event: the peer, and whether the link ever
// came up.  The platform reports a connection that fails and a link that ends as the same state change; the trait says the first is a `Connected`
// with a status that is not 0 and the second a `Disconnected`, so each link is told apart here.  `services_of` reads the table of services and
// characteristics the discovery leaves.  Nothing here touches the phone, so the whole module is tested on the host.

use std.bytes
use central

// One event as the runtime reports it.
pub struct Raw
    kind: Int
    handle: Int
    status: Int
    a: Int
    text: Str
    data: [u8]

// The kinds the runtime reports; the numbers are those of bin/runtime/mobile/novo_rt_android_ble.c, which `event_of` matches by value.
pub const K_SCAN_RESULT = 1
// The kind of an event: a scan failed to start or ended.
pub const K_SCAN_FAILED = 2
// The kind of an event: a link changed state.
pub const K_CONNECTION = 3
// The kind of an event: a discovery finished.
pub const K_SERVICES = 4
// The kind of an event: a read finished.
pub const K_READ = 5
// The kind of an event: a write finished.
pub const K_WRITE = 6
// The kind of an event: a notification or an indication arrived.
pub const K_CHANGED = 7
// The kind of an event: a subscription finished.
pub const K_SUBSCRIBE = 8
// The kind of an event: the MTU of a link changed.
pub const K_MTU = 9
// The kind of an event: the platform answered a request for a priority.
pub const K_PRIORITY = 10
// The kind of an event: the services of the device changed.
pub const K_SERVICE_CHANGED = 11
// The kind of an event: the bond of a link changed.
pub const K_BOND = 12
// The kind of an event: the adapter changed state.
pub const K_ADAPTER = 13
// The kind of an event: the connection's interval, latency and timeout changed.
pub const K_CONN_PARAMS = 14
// The kind of an event: the PHYs of a link changed or were read.
pub const K_PHY = 15
// The kind of an event: events were lost for want of room.
pub const K_DROPPED = 99

// What the table keeps of each link, by handle: its peer, whether it came up, the MTU it settled on, the services its discovery found, and the radio
// parameters the platform told (the interval in units of 1.25 ms, the latency, the supervision timeout in units of 10 ms, the two PHYs).
struct Links
    var peers: [Str]
    var up: [Bool]
    var mtus: [Int]
    var services: [[ServiceInfo]]
    var radio: [[Int]]

// The links of a connection table.  A struct is a reference, so the fields live in `Links` and the functions reach them through a local `var`.
pub struct Table
    st: Links

// An empty table.
pub fn table() -> Table
    Table { st: Links { peers: [""], up: [false], mtus: [23], services: [[]], radio: [[0, 0, 0, 0, 0]] } }

// Records the peer of a new link.
pub fn remember(t: Table, handle: Int, peer: Str) [mutate]
    var st = t.st
    for _i in 0..handle + 1
        if list.len(st.peers) <= handle
            list.push(st.peers, "")
            list.push(st.up, false)
            list.push(st.mtus, 23)
            list.push(st.services, [])
            list.push(st.radio, [0, 0, 0, 0, 0])
    st.peers[handle] = peer
    st.up[handle] = false
    st.mtus[handle] = 23
    st.services[handle] = []
    st.radio[handle] = [0, 0, 0, 0, 0]

fn peer_of(t: Table, handle: Int) -> PeerId
    if handle >= 0 and handle < list.len(t.st.peers)
        return central.peer(t.st.peers[handle])
    central.peer("")

fn was_up(t: Table, handle: Int) -> Bool
    handle >= 0 and handle < list.len(t.st.up) and t.st.up[handle]

// The services a discovery found, kept for `services`.
pub fn set_services(t: Table, handle: Int, found: [ServiceInfo]) [mutate]
    var st = t.st
    if handle >= 0 and handle < list.len(st.services)
        st.services[handle] = found[:]

// The services the last discovery of the link found.
pub fn services_of_link(t: Table, handle: Int) -> [ServiceInfo]
    if handle >= 0 and handle < list.len(t.st.services)
        return t.st.services[handle][:]
    []

// The largest write on the link: the MTU less the 3 bytes of the ATT header, and never more than the 512 bytes an attribute holds; 0 for a link the table does not know.
pub fn max_write_of(t: Table, handle: Int) -> Int
    if handle >= 1 and handle < list.len(t.st.mtus)
        let room = t.st.mtus[handle] - 3
        return if room > 512 then 512 else room
    0

// The radio parameters of a link as [interval in microseconds, latency, supervision timeout in milliseconds, transmit PHY, receive PHY, MTU]; zeros for
// what the platform has not told, and for a link the table does not know.
pub fn link_info_of(t: Table, handle: Int) -> [Int]
    if handle >= 1 and handle < list.len(t.st.radio)
        let r = t.st.radio[handle]
        return [r[0] * 1250, r[1], r[2] * 10, r[3], r[4], t.st.mtus[handle]]
    [0, 0, 0, 0, 0, 0]

// Keeps what a radio event told of a link: kind 14 the interval, the latency and the timeout, kind 15 the PHYs; an event that failed tells nothing.
fn note_radio(t: Table, r: Raw) [mutate]
    var st = t.st
    if r.status != 0 or r.handle < 1 or r.handle >= list.len(st.radio)
        return
    if r.kind == 14
        let parts = str.split(r.text, " ")
        st.radio[r.handle][0] = r.a
        st.radio[r.handle][1] = str.to_int(parts[0]) ?? 0
        if list.len(parts) > 1
            st.radio[r.handle][2] = str.to_int(parts[1]) ?? 0
    else
        st.radio[r.handle][3] = r.a / 16
        st.radio[r.handle][4] = r.a % 16

fn set_up(t: Table, handle: Int, up: Bool) [mutate]
    var st = t.st
    if handle >= 0 and handle < list.len(st.up)
        st.up[handle] = up

// The state of the adapter the runtime reports as a number.
pub fn adapter_state(n: Int) -> AdapterState
    match n
        1 => AdapterState.On
        2 => AdapterState.NoPermission
        3 => AdapterState.Unsupported
        _ => AdapterState.Off

// The name and address of a scan result: the text is the address, a tab and the name.
pub fn split_text(text: Str) -> [Str]
    let parts = str.split(text, "\t")
    if list.len(parts) >= 2
        return [parts[0], str.join(parts[1:list.len(parts)], "\t")]
    [text, ""]

// The event for a raw one; None for a kind this version does not know and for the radio events, which the table keeps for `link_info_of`.
pub fn event_of(t: Table, r: Raw) -> ?CentralEvent [mutate]
    let link = LinkId { id: r.handle }
    let ch = CharRef { link: r.handle, idx: r.a }
    match r.kind
        1  =>
            let parts = split_text(r.text)
            Some(ScanResult(central.peer(parts[0]), r.status, parts[1], r.data))
        2  => Some(ScanFailed(r.status))
        3  =>
            if r.a == 2
                set_up(t, r.handle, true)
                return Some(Connected(link, peer_of(t, r.handle), r.status))
            if was_up(t, r.handle)
                set_up(t, r.handle, false)
                return Some(Disconnected(link, r.status))
            // A connection that never came up: the platform's status says why, and a status of 0 cannot be a success.
            Some(Connected(link, peer_of(t, r.handle), (if r.status == 0 then 1 else r.status)))
        4  => Some(Discovered(link, r.status))
        5  => Some(ReadDone(link, ch, r.status, r.data))
        6  => Some(WriteDone(link, ch, r.status))
        7  => Some(Notified(link, ch, r.data))
        8  => Some(SubscribeDone(link, ch, r.status))
        9  =>
            if r.status == 0 and r.handle >= 0 and r.handle < list.len(t.st.mtus)
                var st = t.st
                st.mtus[r.handle] = r.a
            Some(MtuChanged(link, r.a, r.status))
        10 => Some(PriorityChanged(link, r.status))
        11 => Some(ServicesChanged(link))
        12 => Some(BondChanged(link, r.a == 1))
        13 => Some(AdapterChanged(adapter_state(r.a)))
        14 =>
            note_radio(t, r)
            None
        15 =>
            note_radio(t, r)
            None
        99 => Some(Dropped(r.a))
        _  => None

fn u16_at(b: [u8], i: Int) -> Int
    b[i] as Int * 256 + b[i + 1] as Int

// The services of a link from the table the runtime keeps: for each service its UUID (16 bytes) and its number of characteristics (2), then for
// each characteristic its UUID (16), properties (2) and index (2).  A table that is cut off ends the list where it ends.
pub fn services_of(link: LinkId, b: [u8]) -> [ServiceInfo]
    var out: [ServiceInfo] = []
    var at = 0
    let n = list.len(b)
    for _s in 0..n / 18 + 1
        if at + 18 > n
            break
        let su = Uuid { b: b[at:at + 16] }
        let count = u16_at(b, at + 16)
        at = at + 18
        var chars: [CharInfo] = []
        for _c in 0..count
            if at + 20 > n
                break
            list.push(chars, CharInfo { uuid: Uuid { b: b[at:at + 16] },
                ref: CharRef { link: link.id, idx: u16_at(b, at + 18) },
                props: u16_at(b, at + 16) })
            at = at + 20
        list.push(out, ServiceInfo { uuid: su, chars: chars })
    out

// The error for a negative result of the runtime's calls.
pub fn error_of(rc: Int, what: Str) -> BleError
    if rc == 0 - 4
        return central.error(E_PERMISSION, "${what}: the app lacks the Bluetooth permission")
    if rc == 0 - 2
        return central.error(E_NOT_CONNECTED, "${what}: no such link")
    if rc == 0 - 5
        return central.error(E_BAD_ARGUMENT, "${what}: a bad argument")
    if rc == 0 - 6
        return central.error(E_BUSY, "${what}: the platform refused to start it")
    central.error(E_UNSUPPORTED, "${what}: the phone has no Bluetooth LE, or the runtime was not opened (${rc})")

// The result of a call that answers 0 or an error: nothing, or the error.
pub fn done(rc: Int, what: Str) -> ?BleError
    if rc == 0
        return None
    Some(decode.error_of(rc, what))

// The number for a security level.
pub fn sec_level(s: Security) -> Int
    match s
        Security.Unsecured     => 0
        Security.Encrypted     => 1
        Security.Authenticated => 2

// The UUIDs as text, separated by commas.
pub fn uuid_list(us: [Uuid]) -> Str
    var texts: [Str] = []
    for u in us
        list.push(texts, central.uuid_text(u))
    str.join(texts, ",")

// A list of bytes as the runtime's Bytes buffer.
pub fn to_bytes(data: [u8]) -> Bytes
    var ints: [Int] = []
    for i in 0..list.len(data)
        list.push(ints, data[i] as Int)
    bytes.from_byte_list(ints)
